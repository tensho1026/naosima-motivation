{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naoshima-bound",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naosima-motivation",
      "database_id": "b685e45a-ee07-4b56-afb7-f9ea1e3645e0",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "naoshima-bound-photos",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
